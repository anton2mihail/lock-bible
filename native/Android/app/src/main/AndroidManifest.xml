<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <queries><intent><action android:name="android.speech.action.RECOGNIZE_SPEECH" /></intent><intent><action android:name="android.intent.action.TTS_SERVICE" /></intent></queries>
    <application android:allowBackup="false" android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules" android:label="John 1:1" android:icon="@mipmap/ic_launcher"
        android:theme="@style/Theme.John" android:supportsRtl="true">
        <activity android:name=".MainActivity" android:exported="true" android:launchMode="singleTop" android:windowSoftInputMode="adjustResize">
            <intent-filter><action android:name="android.intent.action.MAIN" /><category android:name="android.intent.category.LAUNCHER" /></intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" /><category android:name="android.intent.category.DEFAULT" /><category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="nrsv" /><data android:scheme="john" /><data android:scheme="john11" />
            </intent-filter>
        </activity>
        <activity android:name=".platform.SaintWidgetConfigurationActivity" android:exported="true">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" /></intent-filter>
        </activity>
        <receiver android:name=".platform.SaintReminderReceiver" android:exported="false" />
        <receiver android:name=".platform.MySaintWidget" android:label="My Saint" android:exported="false">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/saint_widget" />
        </receiver>
        <service android:name=".platform.JohnPlaybackService" android:exported="false" android:foregroundServiceType="mediaPlayback" />
        <receiver android:name=".platform.JohnWidgetRefreshReceiver" android:exported="false" />
        <receiver android:name=".platform.JohnReminderReceiver" android:exported="false" />
        <receiver android:name=".platform.JohnBootReceiver" android:exported="true">
            <intent-filter><action android:name="android.intent.action.BOOT_COMPLETED" /><action android:name="android.intent.action.TIMEZONE_CHANGED" /><action android:name="android.intent.action.TIME_SET" /></intent-filter>
        </receiver>
        <receiver android:name=".platform.JohnVerseWidget" android:label="Daily Verse" android:exported="false">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/verse_widget" />
        </receiver>
        <receiver android:name=".platform.JohnDailyWidget" android:label="Daily Reading" android:exported="false">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/daily_widget" />
        </receiver>
        <receiver android:name=".platform.JohnProgressWidget" android:label="Reading Progress" android:exported="false">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/progress_widget" />
        </receiver>
        <provider android:name="androidx.core.content.FileProvider" android:authorities="${applicationId}.files" android:exported="false" android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
