<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/saint_widget_root" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/saint_widget_background" android:clipToOutline="true">
    <ImageView android:id="@+id/saint_widget_art" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="centerCrop" android:importantForAccessibility="no" />
    <ImageView android:id="@+id/saint_widget_shade" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/saint_widget_shade" android:importantForAccessibility="no" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_gravity="bottom" android:orientation="vertical" android:padding="16dp">
        <TextView android:id="@+id/saint_widget_name" android:layout_width="match_parent" android:layout_height="wrap_content" android:fontFamily="@font/lora_regular" android:textSize="21sp" android:textColor="#FFFFFF" android:maxLines="3" android:ellipsize="end" android:text="My Saints" />
        <TextView android:id="@+id/saint_widget_caption" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:fontFamily="@font/space_grotesk_regular" android:textSize="12sp" android:textColor="#FFFFFF" android:maxLines="2" android:ellipsize="end" android:text="Choose a saint" />
    </LinearLayout>
</FrameLayout>
