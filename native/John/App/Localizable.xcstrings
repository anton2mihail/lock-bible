      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajustes"
          }
        }
      }
    },
    "Some installed reading information could not be opened.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo abrir parte de la información de lectura instalada."
          }
        }
      }
    },
    "%lld complete Catholic editions are available offline. Your choice also controls the rotating verse and lock-screen widget.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld ediciones católicas completas están disponibles sin conexión. Tu elección también controla el versículo rotativo y el widget de la pantalla de bloqueo."
          }
        }
      }
    },
    "Which part of Scripture the rotating verse is drawn from. Old Testament includes the deuterocanonical books.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "De qué parte de la Escritura se toma el versículo rotativo. El Antiguo Testamento incluye los libros deuterocanónicos."
          }
        }
      }
    },
    "How often the Verse of the Moment and your lock screen widget change.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Con qué frecuencia cambian el Versículo del Momento y el widget de la pantalla de bloqueo."
          }
        }
      }
    },
