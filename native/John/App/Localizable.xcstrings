    "A WORD TO CARRY WITH YOU": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "UNA PALABRA PARA LLEVAR CONTIGO"
          }
        }
      }
    },
