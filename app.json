{
  "name": "John 1:1",
  "slug": "NRSV",
  "scheme": "nrsv",
  "version": "1.2.2",
  "orientation": "portrait",
  "userInterfaceStyle": "automatic",
  "icon": "./assets/artwork/john-icon.png",
  "updates": {
    "fallbackToCacheTimeout": 0
  },
  "assetBundlePatterns": [
    "**/*"
  ],
  "android": {
    "icon": "./assets/artwork/john-icon.png",
    "package": "com.nrsv.verse",
    "permissions": [
      "android.permission.SCHEDULE_EXACT_ALARM"
    ],
    "adaptiveIcon": {
      "foregroundImage": "./assets/artwork/john-adaptive-foreground.png",
      "backgroundImage": "./assets/artwork/john-adaptive-background.png",
      "monochromeImage": "./assets/artwork/john-adaptive-monochrome.png"
    },
    "allowBackup": false
  },
  "ios": {
    "icon": {
      "light": "./assets/artwork/john-icon.png",
      "dark": "./assets/artwork/john-icon-dark.png",
      "tinted": "./assets/artwork/john-icon-tinted.png"
    },
    "supportsTablet": true,
    "bundleIdentifier": "com.nrsv.verse",
    "buildNumber": "15",
    "appleTeamId": "QZ44N522NQ",
    "config": {
      "usesNonExemptEncryption": false
    }
  },
  "web": {
    "favicon": "./assets/images/john-favicon.png",
    "bundler": "metro"
  },
  "plugins": [
    "expo-localization",
    "expo-font",
    "expo-notifications",
    [
      "expo-video",
      {
        "supportsPictureInPicture": false
      }
    ],
    [
      "expo-audio",
      {
        "enableBackgroundPlayback": false,
        "microphonePermission": false,
        "recordAudioAndroid": false
      }
    ],
    "@react-native-community/datetimepicker",
    [
      "expo-splash-screen",
      {
        "image": "./assets/artwork/john-splash.png",
        "imageWidth": 120,
        "resizeMode": "contain",
        "backgroundColor": "#371026",
        "dark": {
          "backgroundColor": "#371026"
        }
      }
    ],
    [
      "react-native-edge-to-edge",
      {
        "android": {
          "parentTheme": "Light",
          "enforceNavigationBarContrast": false
        }
      }
    ],
    "expo-build-properties",
    "expo-sqlite",
    "expo-router",
    "expo-sharing"
  ],
  "experiments": {
    "tsconfigPaths": true,
    "typedRoutes": true
  },
  "extra": {
    "ignite": {
      "version": "11.5.0"
    },
    "router": {},
    "eas": {
      "build": {
        "experimental": {
          "ios": {
            "appExtensions": [
              {
                "bundleIdentifier": "com.nrsv.verse.widget",
                "targetName": "VerseWidget",
                "entitlements": {
                  "com.apple.security.application-groups": [
                    "group.com.nrsv.verse"
                  ]
                }
              }
            ]
          }
        }
      },
      "projectId": "043ec1d0-2b2d-43cc-ac8c-ba07f5ed686b"
    }
  },
  "owner": "antonmihail"
}
