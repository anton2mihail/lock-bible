{
  "name": "nrsv",
  "version": "0.0.1",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "bundle:web": "npx expo export --platform web",
    "serve:web": "npx serve dist",
    "prebuild:clean": "npx expo prebuild --clean",
    "compile": "tsc --noEmit -p . --pretty",
    "lint": "eslint . --fix",
    "lint:check": "eslint .",
    "depcruise": "depcruise src --config .dependency-cruiser.js",
    "depcruise:graph": "depcruise app --include-only \"^app\" --config .dependency-cruiser.js --output-type dot > app-dependency-graph.dot && dot -T svg app-dependency-graph.dot -o app-dependency-graph.svg && dot -T png app-dependency-graph.dot -o app-dependency-graph.png && rm app-dependency-graph.dot",
    "align-deps": "npx expo install --fix",
    "build:bible": "node scripts/build-bible-data.mjs",
    "build:widget-data": "node scripts/build-widget-data.mjs",
    "build:bible-search": "bun scripts/build-bible-search.mjs",
    "verify:bible-search": "bun scripts/verify-bible-search.mjs",
    "verify:widget-data": "node scripts/verify-widget-data.mjs",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:maestro": "maestro test -e MAESTRO_APP_ID=com.nrsv.verse -e MAESTRO_METRO_PORT=8081 .maestro/flows",
    "adb": "adb reverse tcp:9090 tcp:9090 && adb reverse tcp:3000 tcp:3000 && adb reverse tcp:9001 tcp:9001 && adb reverse tcp:8081 tcp:8081",
    "prebuild:ios": "npx expo prebuild --platform ios --clean",
    "build:ios": "bun x eas build --platform ios --local --profile production",
    "build:android": "bun x eas build --platform android --local --profile production",
    "build:ios-sim": "bun x eas build --profile development-simulator --platform ios --local --output ./build/lockbible-ios-sim.tar.gz",
    "build:android-sim": "bun x eas build --profile development-simulator --platform android --local",
    "submit:ios": "eas submit --platform ios --profile production",
    "build:daily-reading-widget": "node scripts/build-daily-reading-widget.mjs"
  },
  "dependencies": {
    "@bacons/apple-targets": "^4.0.7",
    "@expo-google-fonts/lora": "^0.4.2",
    "@expo-google-fonts/space-grotesk": "^0.4.0",
    "@expo/metro-runtime": "~55.0.12",
    "@expo/vector-icons": "^15.0.2",
    "@react-native-community/datetimepicker": "8.6.0",
    "@react-navigation/bottom-tabs": "^7.2.0",
    "@react-navigation/native": "^7.0.14",
    "@react-navigation/native-stack": "^7.2.0",
    "apisauce": "3.1.1",
    "date-fns": "^4.1.0",
    "expo": "~55.0.28",
    "expo-audio": "~55.0.18",
    "expo-build-properties": "~55.0.16",
    "expo-clipboard": "~55.0.15",
    "expo-constants": "~55.0.17",
    "expo-dev-client": "~55.0.37",
    "expo-font": "~55.0.4",
    "expo-linking": "~55.0.7",
    "expo-localization": "~55.0.17",
    "expo-notifications": "~55.0.27",
    "expo-router": "~55.0.17",
    "expo-sharing": "~55.0.24",
    "expo-splash-screen": "~55.0.23",
    "expo-sqlite": "~55.0.18",
    "expo-system-ui": "~55.0.20",
    "expo-video": "~55.0.21",
    "i18next": "^23.14.0",
    "intl-pluralrules": "^2.0.1",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-i18next": "^15.0.1",
    "react-native": "0.83.10",
    "react-native-drawer-layout": "^4.0.1",
    "react-native-edge-to-edge": "~1.6.1",
    "react-native-gesture-handler": "~2.30.0",
    "react-native-keyboard-controller": "1.20.7",
    "react-native-mmkv": "3.3.3",
    "react-native-reanimated": "4.2.1",
    "react-native-safe-area-context": "~5.6.2",
    "react-native-screens": "~4.23.0",
    "react-native-view-shot": "4.0.3",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.7.4",
    "setimmediate": "^1.0.5"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0",
    "@babel/preset-env": "^7.20.0",
    "@babel/runtime": "^7.20.0",
    "@romcal/calendar.united-states": "3.0.0-dev.117",
    "@testing-library/react-native": "^13.2.0",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.2.10",
    "babel-jest": "^29.2.1",
    "dependency-cruiser": "^17.0.2",
    "eas-cli": "^20.4.0",
    "eslint": "^8.57.0",
    "eslint-config-expo": "~55.0.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.2.1",
    "eslint-plugin-react-native": "^4.1.0",
    "eslint-plugin-reactotron": "^0.1.2",
    "jest": "~29.7.0",
    "jest-expo": "~55.0.20",
    "prettier": "^3.3.3",
    "react-test-renderer": "19.2.0",
    "reactotron-core-client": "^2.9.4",
    "reactotron-react-js": "^3.3.11",
    "reactotron-react-native": "^5.0.5",
    "reactotron-react-native-mmkv": "^0.2.6",
    "romcal": "3.0.0-dev.117",
    "ts-jest": "^29.1.1",
    "tsx": "^4.20.3",
    "typescript": "~5.9.2"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "packageManager": "bun@1.3.14",
  "patchedDependencies": {
    "@bacons/apple-targets@4.0.7": "patches/@bacons%2Fapple-targets@4.0.7.patch"
  }
}
